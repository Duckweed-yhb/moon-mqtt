///|
/// browser — 浏览器 MQTT 客户端高层封装（js 后端）
///
/// 在 WebSocket 上跑 MQTT 3.1.1，内部持有 @core.ClientCore 纯计算状态机。
/// WebSocket 由 JS 胶水持有，MoonBit 侧只做纯计算。提供 connect /
/// subscribe / publish / disconnect / on_message 高层 API。
///
/// 发布支持 QoS0/1/2：QoS1/2 走 core.publish()，packet_id 与在途由 core/session 管理。
/// 入站 QoS1/2 PUBLISH 由 core.feed() 自动回 PUBACK/PUBREC/PUBCOMP。
/// API：connect / connect_opts / connect_persistent / on_connect / on_suback /
/// on_message / subscribe / publish / disconnect。
supported_targets = "js"

import {
  "Duckweed/moon-mqtt/core" @core,
  "Duckweed/moon-mqtt/protocol" @protocol,
}
