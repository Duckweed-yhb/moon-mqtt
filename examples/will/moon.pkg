///|
/// examples/will — 演示 CONNECT 遗嘱字段：异常掉线时 broker 自动发 will 消息。
///
/// 用法：先起一个订阅端 `mosquitto_sub -t status`，再跑本示例；
/// 正常 disconnect 不会发 will，kill -9 / 网络断才会。
supported_targets = "native"

pkgtype(kind: "executable")

import {
  "Duckweed/moon-mqtt/protocol" @protocol,
  "Duckweed/moon-mqtt/client" @client,
}
